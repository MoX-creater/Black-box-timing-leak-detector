# Reference only: the application does not automatically load .env files.
# Export values in the shell that starts the process. No values below are
# credentials or secrets.

# Web listener defaults.
HOST=0.0.0.0
PORT=3000

# Reverse-proxy and bounded web-run settings.
TRUST_PROXY_HOPS=0
SCAN_SEED=web-scan-seed
SCAN_MAX_DURATION_MS=30000
SCAN_REQUEST_TIMEOUT_MS=5000

# Demo noise settings. The launcher supplies the demo defaults itself.
DEMO_NOISE_PRESET=none
DEMO_NOISE_SEED=demo-noise-seed
DEMO_NOISE_JITTER=0

# Internal demo target settings used by the web process.
DEMO_FIXED_HOST=fixed
DEMO_FIXED_PORT=3002
DEMO_VULNERABLE_HOST=vulnerable
DEMO_VULNERABLE_PORT=3001

# Optional direct-demo settings. Leave DEMO_MODE unset when the launcher is
# starting both demo modes; the launcher selects each child mode by service.
# DEMO_MODE=vulnerable
# SERVICE_NAME=vulnerable

# Optional full commit identifier supplied to build metadata. Empty means the
# application reports the commit as unavailable.
GIT_COMMIT=

# Internal launcher-only flag. The launcher sets this for its web child; it is
# shown here because the source reads it, but it is normally not user-set.
# LAUNCHER_STARTUP_GATE=1
